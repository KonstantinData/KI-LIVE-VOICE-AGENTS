[global]
type=global
user_agent=Mein-Kuechenexperte-Anna

[transport-udp]
type=transport
protocol=udp
bind=0.0.0.0:5060
local_net=172.30.42.0/24
external_signaling_address=${PUBLIC_IP}
external_media_address=${PUBLIC_IP}

[anna]
type=endpoint
transport=transport-udp
context=from-anna
disallow=all
allow=alaw,ulaw
auth=anna-auth
aors=anna-aor
direct_media=no
; Keep the Asterisk-to-Anna SDP on the private Docker network. The shared
; transport advertises PUBLIC_IP for Easybell, which Anna correctly rejects as
; foreign media on its internal SIP leg.
media_address=172.30.42.2
force_rport=yes
rewrite_contact=yes
rtp_symmetric=yes

[anna-auth]
type=auth
auth_type=userpass
username=${ANNA_INTERNAL_SIP_USERNAME}
password=${ANNA_INTERNAL_SIP_PASSWORD}

[anna-aor]
type=aor
max_contacts=1
remove_existing=yes

[anna-identify]
type=identify
endpoint=anna
match=172.30.42.0/24

[easybell-auth]
type=auth
auth_type=userpass
username=${EASYBELL_SIP_USERNAME}
password=${EASYBELL_SIP_PASSWORD}
realm=voip.easybell.de

[easybell-aor]
type=aor
contact=sip:${EASYBELL_CONTACT_USER}@voip.easybell.de

[easybell]
type=endpoint
transport=transport-udp
context=from-easybell
disallow=all
allow=alaw,ulaw
outbound_auth=easybell-auth
aors=easybell-aor
from_domain=voip.easybell.de
direct_media=no
force_rport=yes
rewrite_contact=yes
rtp_symmetric=yes
identify_by=auth_username,username

[easybell-identify]
type=identify
endpoint=easybell
match=voip.easybell.de

[easybell-registration]
type=registration
transport=transport-udp
outbound_auth=easybell-auth
server_uri=sip:voip.easybell.de
client_uri=sip:${EASYBELL_SIP_USERNAME}@voip.easybell.de
contact_user=${EASYBELL_CONTACT_USER}
endpoint=easybell
line=yes
retry_interval=60
forbidden_retry_interval=600
expiration=300
