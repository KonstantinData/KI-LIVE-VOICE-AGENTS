        <mxCell id="contact" value="&lt;b&gt;Erster Kontakt&lt;/b&gt;&lt;br&gt;&lt;br&gt;Besucher sieht den MIA-Einstieg auf der Website." style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F1F4F2;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=20;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120" y="240" width="350" height="100" as="geometry" />
        </mxCell>
        <mxCell id="start" value="&lt;b&gt;MIA bewusst starten&lt;/b&gt;&lt;br&gt;&lt;br&gt;„Meine erste Küchenidee entwickeln“" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F4F2;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=20;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120" y="400" width="350" height="100" as="geometry" />
        </mxCell>
        <mxCell id="intro" value="&lt;b&gt;Nutzen und Reihenfolge zeigen&lt;/b&gt;&lt;br&gt;&lt;br&gt;„Mit MIA Ihre erste Küchenidee entwickeln.&lt;br&gt;Details und eigener Raum folgen danach.“&lt;br&gt;MIA ist als KI erkennbar." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E5EEE7;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=20;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="650" y="385" width="540" height="150" as="geometry" />
        </mxCell>
        <mxCell id="channel" value="&lt;b&gt;Sprache oder Text?&lt;/b&gt;" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#FFF2D7;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=20;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="170" y="600" width="250" height="140" as="geometry" />
        </mxCell>
        <mxCell id="voice" value="&lt;b&gt;Sprache wählen&lt;/b&gt;&lt;br&gt;&lt;br&gt;Mikrofonzugriff anfragen." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F4F2;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=20;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="65" y="830" width="220" height="100" as="geometry" />
        </mxCell>
        <mxCell id="text" value="&lt;b&gt;Text wählen / fortsetzen&lt;/b&gt;&lt;br&gt;&lt;br&gt;Vollständiger Ablauf ohne Mikrofon." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F4F2;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=20;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="330" y="830" width="210" height="115" as="geometry" />
        </mxCell>
        <mxCell id="mic" value="&lt;b&gt;Mikrofon verfügbar&#10;und freigegeben?&lt;/b&gt;" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#FFF2D7;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=18;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="65" y="1020" width="220" height="140" as="geometry" />
        </mxCell>
        <mxCell id="open-question" value="&lt;b&gt;Persönlicher Gesprächseinstieg&lt;/b&gt;&lt;br&gt;&lt;br&gt;„Hallo, ich bin MIA, Ihre KI-Küchenassistentin.&lt;br&gt;Was soll Ihre neue Küche für Sie besser machen?“" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E5EEE7;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=20;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="650" y="1100" width="540" height="160" as="geometry" />
        </mxCell>
        <mxCell id="answer" value="&lt;b&gt;Kunde erzählt oder schreibt&lt;/b&gt;&lt;br&gt;&lt;br&gt;Alltag, Wünsche und Vorlieben dürfen in einer Antwort zusammenkommen.&lt;br&gt;Korrekturen sind jederzeit möglich." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F4F2;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=20;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="120" y="1330" width="350" height="160" as="geometry" />
        </mxCell>
        <mxCell id="capture" value="&lt;b&gt;Angaben intern übernehmen&lt;/b&gt;&lt;br&gt;&lt;br&gt;Kochalltag und wichtigste Verbesserung&lt;br&gt;Unverzichtbares / Behaltenes&lt;br&gt;Atmosphäre / Stil&lt;br&gt;Bekanntes, Offenes und Korrekturen trennen." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FAF8F1;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=19;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1330" y="1330" width="450" height="175" as="geometry" />
        </mxCell>
        <mxCell id="adaptive" value="&lt;b&gt;Adaptiver Fragerouter&lt;/b&gt;&lt;br&gt;&lt;br&gt;Eine passende nächste Frage oder direkt zum Abschluss.&lt;br&gt;Bekanntes überspringen, keine Wunschliste vorlesen.&lt;br&gt;Detaillierte Verzweigungen: Seite 02." style="shape=process;whiteSpace=wrap;html=1;fillColor=#E5EEE7;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=20;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="650" y="1570" width="540" height="190" as="geometry" />
        </mxCell>
        <mxCell id="prepare" value="&lt;b&gt;Entwurfsauftrag vorbereiten&lt;/b&gt;&lt;br&gt;&lt;br&gt;Wünsche steuern Auswahl und begrenzte Anpassung einer vorbereiteten Grundplanung.&lt;br&gt;Rasterraum 10 × 10 m als Präsentationsszene.&lt;br&gt;Keine freie Planung, keine Kundenraummaße erfinden." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FAF8F1;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=19;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1330" y="1810" width="450" height="195" as="geometry" />
        </mxCell>
        <mxCell id="end" value="&lt;b&gt;„Ich erstelle jetzt einen ersten Entwurf.“&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#193C32;strokeColor=#193C32;fontColor=#FFFFFF;fontFamily=Arial;fontSize=25;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="650" y="2050" width="540" height="105" as="geometry" />
        </mxCell>
        <mxCell id="scope" value="&lt;b&gt;Grenzen dieses Erstgesprächs&lt;/b&gt;&lt;br&gt;&lt;br&gt;Keine Raummaße, Grundrisse, Fenster- oder Anschlussfragen.&lt;br&gt;Keine Kontakt- oder Eigentümerqualifizierung.&lt;br&gt;Keine Pflicht-Bilderstrecke und keine gesprochene Zusammenfassung.&lt;br&gt;Generierung, Ansicht und Detailarbeit liegen nach dem Endpunkt." style="shape=note;size=20;whiteSpace=wrap;html=1;fillColor=#FAF8F1;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=19;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
