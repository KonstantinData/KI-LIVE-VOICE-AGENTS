        <mxCell id="new" value="&lt;b&gt;Neue Kundenantwort liegt vor&lt;/b&gt;&lt;br&gt;&lt;br&gt;Sprache, Text, Bildauswahl oder spontane Korrektur." style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F1F4F2;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=20;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
