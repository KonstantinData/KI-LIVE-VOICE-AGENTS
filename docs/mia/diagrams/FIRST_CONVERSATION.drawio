  <diagram id="appliances" name="04 · Gerätewünsche gezielt klären">
    <mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2100" pageHeight="2520" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="04 · Gerätewünsche gezielt klären" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=34;fontColor=#193C32;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="2020" height="60" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Ergänzung zu Seite 02 · Kühlschrank und Geschirrspüler getrennt behandeln · Einbau- und Standgeräte dürfen zusammenkommen" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=19;fontColor=#193C32;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="85" width="2020" height="60" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="MIA · mein-kuechenexperte.de · Konzeptstand 15.10.2026 · Ablaufvorschlag, keine gemessene Produktfunktion" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#627367;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="2472" width="2020" height="26" as="geometry" />
        </mxCell>
        <mxCell id="a-start" value="&lt;b&gt;Gerätegestaltung ist gerade relevant&lt;/b&gt;&lt;br&gt;&lt;br&gt;Auswahl im adaptiven Fragerouter auf Seite 02.&lt;br&gt;Keine zusätzliche Pflichtstation." style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#F1F4F2;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=20;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="760" y="170" width="580" height="115" as="geometry" />
        </mxCell>
        <mxCell id="a-known" value="&lt;b&gt;Welche Angaben sind bereits bekannt?&lt;/b&gt;&lt;br&gt;&lt;br&gt;Je Gerät prüfen: Integration / Sichtbarkeit, Gerätetyp, Behaltenes.&lt;br&gt;„Kühl-Gefrier-Kombination“ allein klärt die Integration nicht." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FAF8F1;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=19;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="760" y="340" width="580" height="150" as="geometry" />
        </mxCell>
        <mxCell id="a-gap" value="&lt;b&gt;Relevante Integration&#10;noch ungefragt?&lt;/b&gt;" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#FFF2D7;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=20;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="890" y="550" width="320" height="160" as="geometry" />
        </mxCell>
        <mxCell id="a-time" value="&lt;b&gt;Neue Frage noch zulässig?&lt;/b&gt;&lt;br&gt;Unter ca. 90 Sekunden&lt;br&gt;und kein Abschlusswunsch?" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#FFF2D7;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=19;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="890" y="790" width="320" height="180" as="geometry" />
        </mxCell>
        <mxCell id="a-skip" value="&lt;b&gt;Gerätefrage überspringen&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bekannte Wünsche erhalten.&lt;br&gt;Bewusst offengelassene Punkte nicht erneut fragen." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F4F2;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=19;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="65" y="550" width="540" height="165" as="geometry" />
        </mxCell>
        <mxCell id="a-open" value="&lt;b&gt;Offene Angaben offen lassen&lt;/b&gt;&lt;br&gt;&lt;br&gt;Keinen pauschalen Integrationsstandard einsetzen.&lt;br&gt;Details können nach dem ersten Entwurf folgen." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F4F2;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=19;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="65" y="800" width="540" height="165" as="geometry" />
        </mxCell>
        <mxCell id="a-question" value="&lt;b&gt;Nur die fehlenden Angaben ansprechen&lt;/b&gt;&lt;br&gt;&lt;br&gt;Beide offen:&lt;br&gt;„Möchten Sie Kühlschrank und Geschirrspüler hinter den Möbelfronten verschwinden lassen, oder sollen einzelne Geräte sichtbar bleiben?“&lt;br&gt;&lt;br&gt;Nur ein Gerät offen, z. B.:&lt;br&gt;„Soll Ihr Kühlschrank hinter einer Möbelfront verschwinden oder sichtbar bleiben?“" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E5EEE7;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=20;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="760" y="1050" width="580" height="310" as="geometry" />
        </mxCell>
        <mxCell id="a-answer" value="&lt;b&gt;Kunde antwortet frei&lt;/b&gt;&lt;br&gt;&lt;br&gt;„Der Geschirrspüler soll voll integriert sein.&lt;br&gt;Beim Kühlschrank möchte ich einen Side-by-Side.“&lt;br&gt;&lt;br&gt;Auch „weiß nicht“, Korrekturen und gemischte Antworten zulassen." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F4F2;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=20;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="760" y="1430" width="580" height="195" as="geometry" />
        </mxCell>
        <mxCell id="a-dish" value="&lt;b&gt;Geschirrspüler separat übernehmen&lt;/b&gt;&lt;br&gt;&lt;br&gt;Integration: voll integriert.&lt;br&gt;Möbelfront vor dem Gerät.&lt;br&gt;Keine Übertragung auf den Kühlschrank." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FAF8F1;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=19;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="65" y="1730" width="540" height="175" as="geometry" />
        </mxCell>
        <mxCell id="a-fridge" value="&lt;b&gt;Kühlschrank separat übernehmen&lt;/b&gt;&lt;br&gt;&lt;br&gt;Typ: Side-by-Side.&lt;br&gt;Im Gesprächskontext als sichtbaren Vorschlag darstellen.&lt;br&gt;Ohne klare Sichtbarkeitspräferenz: vorläufig kennzeichnen.&lt;br&gt;Breite bleibt unbekannt, solange nicht genannt." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FAF8F1;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=19;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="760" y="1730" width="580" height="205" as="geometry" />
        </mxCell>
        <mxCell id="a-unclear" value="&lt;b&gt;Unklare oder fehlende Antwort&lt;/b&gt;&lt;br&gt;&lt;br&gt;Nur eindeutig Beantwortetes übernehmen.&lt;br&gt;Keine pauschale Zustimmung für beide Geräte erfinden.&lt;br&gt;„Weiß nicht / später“ bleibt bewusst offen." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFF2D7;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=19;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1510" y="1430" width="510" height="195" as="geometry" />
        </mxCell>
        <mxCell id="a-rules" value="&lt;b&gt;Keine zusätzliche Detailplanung&lt;/b&gt;&lt;br&gt;&lt;br&gt;Keine Breiten aus dem Gerätetyp ableiten.&lt;br&gt;Behaltene Geräte respektieren.&lt;br&gt;Abzug ist eine eigene Präferenz.&lt;br&gt;Keine Anschluss- oder Raummaßfragen.&lt;br&gt;Keine technische Einbaufreigabe." style="shape=note;size=20;whiteSpace=wrap;html=1;fillColor=#FAF8F1;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=19;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1510" y="340" width="510" height="295" as="geometry" />
        </mxCell>
        <mxCell id="a-merge" value="&lt;b&gt;Zum Fragerouter zurück: Antwortstatus aktualisieren&lt;/b&gt;&lt;br&gt;&lt;br&gt;Wünsche je Gerät und offene Angaben in denselben Entwurfsauftrag übernehmen.&lt;br&gt;Eine gezielte Klärung nur über den zeitgeprüften Router; keine automatische zweite Gerätefrage." style="shape=process;whiteSpace=wrap;html=1;fillColor=#FAF8F1;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=19;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="760" y="2010" width="580" height="210" as="geometry" />
        </mxCell>
        <mxCell id="a-end" value="&lt;b&gt;„Ich erstelle jetzt einen ersten Entwurf.“&lt;/b&gt;&lt;br&gt;&lt;br&gt;Wenn der Router abschließt; weiterhin höchstens 120 Sekunden Erstgespräch." style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#193C32;strokeColor=#193C32;fontColor=#FFFFFF;fontFamily=Arial;fontSize=22;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="760" y="2320" width="580" height="130" as="geometry" />
        </mxCell>
        <mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=24;html=1;endArrow=block;endFill=1;strokeColor=#193C32;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Arial;fontSize=18;fontColor=#193C32;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1" source="a-start" target="a-known">
