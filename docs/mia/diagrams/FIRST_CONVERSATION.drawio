  <diagram id="example" name="03 · Beispielgespräch bis zum Entwurfsstart">
    <mxGraphModel dx="1500" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1860" pageHeight="1980" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="03 · Beispielgespräch bis zum Entwurfsstart" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=34;fontColor=#193C32;fontStyle=1;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1780" height="60" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Erfundener Kundenfall · Zeitfenster sind eine Gesprächsplanung, keine Laufzeitmessung · Stilfrage entfällt, Korrektur bleibt lokal" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=19;fontColor=#193C32;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="85" width="1780" height="60" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="MIA · mein-kuechenexperte.de · Konzeptstand 15.10.2026 · Ablaufvorschlag, keine gemessene Produktfunktion" style="text;html=1;whiteSpace=wrap;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;fontFamily=Arial;fontSize=15;fontColor=#627367;fontStyle=0;spacing=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="1932" width="1780" height="26" as="geometry" />
        </mxCell>
        <mxCell id="ex-mia" value="MIA spricht / zeigt" vertex="1" parent="1" style="swimlane;html=1;startSize=52;horizontal=1;container=0;collapsible=0;fillColor=#E5EEE7;swimlaneFillColor=#FFFFFF;strokeColor=#CED8D0;fontColor=#193C32;fontFamily=Arial;fontSize=22;fontStyle=1;rounded=0;shadow=0;">
          <mxGeometry x="40" y="160" width="600" height="1730" as="geometry" />
        </mxCell>
        <mxCell id="ex-customer" value="Kunde antwortet / korrigiert" vertex="1" parent="1" style="swimlane;html=1;startSize=52;horizontal=1;container=0;collapsible=0;fillColor=#F1F4F2;swimlaneFillColor=#FFFFFF;strokeColor=#CED8D0;fontColor=#193C32;fontFamily=Arial;fontSize=22;fontStyle=1;rounded=0;shadow=0;">
          <mxGeometry x="660" y="160" width="600" height="1730" as="geometry" />
        </mxCell>
        <mxCell id="ex-internal" value="MIA entscheidet intern" vertex="1" parent="1" style="swimlane;html=1;startSize=52;horizontal=1;container=0;collapsible=0;fillColor=#FAF8F1;swimlaneFillColor=#FFFFFF;strokeColor=#CED8D0;fontColor=#193C32;fontFamily=Arial;fontSize=22;fontStyle=1;rounded=0;shadow=0;">
          <mxGeometry x="1280" y="160" width="540" height="1730" as="geometry" />
        </mxCell>
        <mxCell id="ex-start" value="&lt;b&gt;Nach MIA-Start und Wahl Sprache/Text&lt;/b&gt;&lt;br&gt;&lt;br&gt;0–20 Sekunden&lt;br&gt;„Hallo, ich bin MIA, Ihre KI-Küchenassistentin.&lt;br&gt;Was soll Ihre neue Küche für Sie besser machen?“" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E5EEE7;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=20;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="90" y="250" width="500" height="165" as="geometry" />
        </mxCell>
        <mxCell id="ex-answer" value="&lt;b&gt;Freie Antwort&lt;/b&gt;&lt;br&gt;&lt;br&gt;20–50 Sekunden&lt;br&gt;„Wir möchten mit den Kindern zusammen kochen.&lt;br&gt;Mehr freie Arbeitsfläche, helle Fronten und Holz wären schön.“" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F4F2;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=20;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="710" y="450" width="500" height="165" as="geometry" />
        </mxCell>
        <mxCell id="ex-profile" value="&lt;b&gt;Aus einer Antwort mehrere Angaben&lt;/b&gt;&lt;br&gt;&lt;br&gt;Alltag: gemeinsames Kochen&lt;br&gt;Verbesserung: freie Arbeitsfläche&lt;br&gt;Wirkung: helle Fronten und Holz&lt;br&gt;Noch offen: Unverzichtbares / Behaltenes" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FAF8F1;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=19;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1320" y="450" width="450" height="180" as="geometry" />
        </mxCell>
        <mxCell id="ex-must" value="&lt;b&gt;Nur die nächste relevante Frage&lt;/b&gt;&lt;br&gt;&lt;br&gt;50–60 Sekunden&lt;br&gt;„Was muss unbedingt dabei sein oder bleiben?“" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E5EEE7;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=20;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="90" y="710" width="500" height="135" as="geometry" />
        </mxCell>
        <mxCell id="ex-appliance" value="&lt;b&gt;Feste Vorgaben&lt;/b&gt;&lt;br&gt;&lt;br&gt;60–80 Sekunden&lt;br&gt;„Unser 90-Zentimeter-Kühlschrank bleibt.&lt;br&gt;Den Backofen hätte ich gern höher.“" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F4F2;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=20;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="710" y="900" width="500" height="150" as="geometry" />
        </mxCell>
        <mxCell id="ex-correction" value="&lt;b&gt;Spontane Präzisierung&lt;/b&gt;&lt;br&gt;&lt;br&gt;80–95 Sekunden&lt;br&gt;„Mit Holz meine ich nur die Arbeitsplatte.&lt;br&gt;Die Fronten sollen ruhig und hell bleiben.“" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F4F2;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=20;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="710" y="1130" width="500" height="150" as="geometry" />
        </mxCell>
        <mxCell id="ex-update" value="&lt;b&gt;Korrektur gezielt übernehmen&lt;/b&gt;&lt;br&gt;&lt;br&gt;Holz der Arbeitsplatte zuordnen.&lt;br&gt;Fronten hell und ruhig.&lt;br&gt;Kühlschrank erhalten; Ofenwunsch aufnehmen.&lt;br&gt;Keine neue allgemeine Stilfrage." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FAF8F1;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=19;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1320" y="1120" width="450" height="180" as="geometry" />
        </mxCell>
        <mxCell id="ex-skip" value="&lt;b&gt;Bekannte Themen überspringen&lt;/b&gt;&lt;br&gt;&lt;br&gt;Alltag, Verbesserung und Stil sind bekannt.&lt;br&gt;Keine Stilbilder erzwingen; keine Küchenform als Pflichtfrage.&lt;br&gt;Keine Raummaße oder Anschlüsse erfragen." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FAF8F1;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=19;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1320" y="1390" width="450" height="170" as="geometry" />
        </mxCell>
        <mxCell id="ex-ready" value="&lt;b&gt;Passenden Vorlagenvorschlag vorbereiten&lt;/b&gt;&lt;br&gt;&lt;br&gt;95–110 Sekunden&lt;br&gt;Vorlage mit zusätzlicher Arbeitszone als Vorschlag.&lt;br&gt;Kundenziele und feste Möbelgrößen führen.&lt;br&gt;Präsentationsraum: 10 × 10 m.&lt;br&gt;Kundenraum noch unbekannt." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FAF8F1;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=19;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1320" y="1630" width="450" height="235" as="geometry" />
        </mxCell>
        <mxCell id="ex-end" value="&lt;b&gt;„Ich erstelle jetzt einen ersten Entwurf.“&lt;/b&gt;&lt;br&gt;&lt;br&gt;110–120 Sekunden im geplanten Beispiel" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#193C32;strokeColor=#193C32;fontColor=#FFFFFF;fontFamily=Arial;fontSize=23;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="90" y="1710" width="500" height="125" as="geometry" />
        </mxCell>
        <mxCell id="ex-tone" value="&lt;b&gt;Natürlicher Gesprächsfluss&lt;/b&gt;&lt;br&gt;&lt;br&gt;MIA reagiert kurz auf den Inhalt.&lt;br&gt;Sie liest keine Wunschliste vor und verlangt keine Abschlussbestätigung.&lt;br&gt;Änderungen brauchen keinen Gesprächsneustart." style="shape=note;size=20;whiteSpace=wrap;html=1;fillColor=#FAF8F1;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=19;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="80" y="1120" width="520" height="230" as="geometry" />
        </mxCell>
        <mxCell id="ex-boundary" value="&lt;b&gt;Hier endet der dargestellte Abschnitt&lt;/b&gt;&lt;br&gt;&lt;br&gt;Noch kein Bild erzeugt oder gezeigt.&lt;br&gt;Die Aussage kündigt den ersten Entwurf an.&lt;br&gt;Details und echter Raum folgen erst danach." style="shape=note;size=20;whiteSpace=wrap;html=1;fillColor=#FFF2D7;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=19;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="80" y="1430" width="520" height="190" as="geometry" />
        </mxCell>
        <mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=24;html=1;endArrow=block;endFill=1;strokeColor=#193C32;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Arial;fontSize=18;fontColor=#193C32;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1" source="ex-start" target="ex-answer">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="340" y="430" />
              <mxPoint x="960" y="430" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="edge-2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=24;html=1;endArrow=block;endFill=1;strokeColor=#193C32;strokeWidth=2;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontFamily=Arial;fontSize=18;fontColor=#193C32;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1" source="ex-answer" target="ex-profile">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="edge-3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=24;html=1;endArrow=block;endFill=1;strokeColor=#193C32;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Arial;fontSize=18;fontColor=#193C32;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1" source="ex-profile" target="ex-must">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1545" y="670" />
