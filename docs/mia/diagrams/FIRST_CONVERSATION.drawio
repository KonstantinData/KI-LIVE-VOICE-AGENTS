          </mxGeometry>
        </mxCell>
        <mxCell id="edge-4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=24;html=1;endArrow=block;endFill=1;strokeColor=#193C32;strokeWidth=2;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontFamily=Arial;fontSize=18;fontColor=#193C32;labelBackgroundColor=#FFFFFF;labelBorderColor=none;" edge="1" parent="1" source="ex-must" target="ex-appliance">
