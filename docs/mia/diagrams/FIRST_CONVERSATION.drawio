        </mxCell>
        <mxCell id="merge" value="&lt;b&gt;Antwortstatus und Wünsche aktualisieren&lt;/b&gt;&lt;br&gt;&lt;br&gt;Antwort oder Korrektur übernehmen.&lt;br&gt;Ungefragt · bekannt · bewusst offengelassen · erfolglos geklärt unterscheiden." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FAF8F1;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=19;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="790" y="325" width="520" height="165" as="geometry" />
        </mxCell>
        <mxCell id="time" value="&lt;b&gt;Weitere Frage zulässig?&lt;/b&gt;&lt;br&gt;Noch unter ca. 90 Sekunden&lt;br&gt;und kein Abschlusswunsch?" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#FFF2D7;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=19;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="900" y="530" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="conflict" value="&lt;b&gt;Relevante Unklarheit&#10;noch klärbar?&lt;/b&gt;" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#FFF2D7;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=20;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="900" y="760" width="300" height="155" as="geometry" />
        </mxCell>
        <mxCell id="clarify" value="&lt;b&gt;Nur diesen Punkt klären&lt;/b&gt;&lt;br&gt;&lt;br&gt;Beispiel:&lt;br&gt;„Soll der Kühlschrank integriert sein, oder möchten Sie Ihr Standgerät behalten?“&lt;br&gt;Keine Rücklese des ganzen Gesprächs." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E5EEE7;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=19;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1500" y="755" width="450" height="170" as="geometry" />
        </mxCell>
        <mxCell id="gap" value="&lt;b&gt;Relevante Angabe&#10;noch ungefragt?&lt;/b&gt;" style="shape=rhombus;perimeter=rhombusPerimeter;whiteSpace=wrap;html=1;fillColor=#FFF2D7;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=20;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="900" y="990" width="300" height="170" as="geometry" />
        </mxCell>
        <mxCell id="select" value="&lt;b&gt;Genau eine relevante Frage auswählen&lt;/b&gt;&lt;br&gt;&lt;br&gt;Bekannte und bewusst offengelassene Themen überspringen.&lt;br&gt;Die fünf Fragefelder unten sind Alternativen, keine Pflichtfolge." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FAF8F1;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=19;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="790" y="1230" width="520" height="145" as="geometry" />
        </mxCell>
        <mxCell id="q-use" value="&lt;b&gt;Alltag / Verbesserung&lt;/b&gt;&lt;br&gt;&lt;br&gt;„Was soll besser funktionieren?“&lt;br&gt;Nur wenn noch nicht erkennbar." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E5EEE7;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=19;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="70" y="1460" width="350" height="185" as="geometry" />
        </mxCell>
        <mxCell id="q-must" value="&lt;b&gt;Unverzichtbares&lt;/b&gt;&lt;br&gt;&lt;br&gt;„Was muss unbedingt dabei sein oder bleiben?“&lt;br&gt;Keine Detailmaßkette." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E5EEE7;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=19;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="470" y="1460" width="350" height="185" as="geometry" />
        </mxCell>
        <mxCell id="q-style" value="&lt;b&gt;Atmosphäre / Stil&lt;/b&gt;&lt;br&gt;&lt;br&gt;„Welche Richtung gefällt Ihnen?“&lt;br&gt;Wenige Stilbilder nur bei Bedarf." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E5EEE7;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=19;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="870" y="1460" width="350" height="185" as="geometry" />
        </mxCell>
        <mxCell id="q-form" value="&lt;b&gt;Küchenform&lt;/b&gt;&lt;br&gt;&lt;br&gt;„Haben Sie schon eine Küchenform im Kopf?“&lt;br&gt;Sonst Vorschlag zulässig." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#E5EEE7;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=19;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1270" y="1460" width="350" height="185" as="geometry" />
        </mxCell>
        <mxCell id="q-devices" value="&lt;b&gt;Geräte sichtbar oder integriert?&lt;/b&gt;&lt;br&gt;&lt;br&gt;Nur offene Geräte fragen.&lt;br&gt;Mischung möglich.&lt;br&gt;Details: Seite 04." style="shape=process;whiteSpace=wrap;html=1;fillColor=#E5EEE7;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=19;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1630" y="1460" width="330" height="185" as="geometry" />
        </mxCell>
        <mxCell id="response" value="&lt;b&gt;Kunde antwortet / korrigiert&lt;/b&gt;&lt;br&gt;&lt;br&gt;„Weiß nicht“, „später“ oder keine Bildauswahl:&lt;br&gt;als bewusst offen / nicht klärbar markieren.&lt;br&gt;Diesen Punkt nicht erneut auswählen.&lt;br&gt;Korrekturen ändern nur den betroffenen Wert." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F1F4F2;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=19;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="790" y="1740" width="520" height="175" as="geometry" />
        </mxCell>
        <mxCell id="assignment" value="&lt;b&gt;Wunschbasierten Entwurfsauftrag bilden&lt;/b&gt;&lt;br&gt;&lt;br&gt;Vorbereitete Grundplanung als Vorschlag auswählen.&lt;br&gt;Bekannte harte Vorgaben erhalten.&lt;br&gt;Offene Angaben / Widersprüche kennzeichnen.&lt;br&gt;Keine Kundenraummaße ableiten." style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FAF8F1;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=19;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="1500" y="1950" width="450" height="190" as="geometry" />
        </mxCell>
        <mxCell id="terminal" value="&lt;b&gt;„Ich erstelle jetzt einen ersten Entwurf.“&lt;/b&gt;" style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#193C32;strokeColor=#193C32;fontColor=#FFFFFF;fontFamily=Arial;fontSize=24;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="790" y="2190" width="520" height="100" as="geometry" />
        </mxCell>
        <mxCell id="rules" value="&lt;b&gt;Gesprächsregeln&lt;/b&gt;&lt;br&gt;&lt;br&gt;Eine relevante Frage pro Turn.&lt;br&gt;Empathie kurz und passend; Humor nur situativ.&lt;br&gt;Kein gesprochenes Zwischenprotokoll.&lt;br&gt;Bei Unentschlossenheit einen Vorschlag anbieten.&lt;br&gt;Freiwillige Raumdaten nur für später vormerken." style="shape=note;size=20;whiteSpace=wrap;html=1;fillColor=#FAF8F1;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=19;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="70" y="320" width="575" height="285" as="geometry" />
        </mxCell>
        <mxCell id="time-note" value="&lt;b&gt;Zeitvorgabe und offener Grenzfall&lt;/b&gt;&lt;br&gt;&lt;br&gt;Maximal 120 Sekunden inklusive MIA, Kunde, Pausen und Bedienung.&lt;br&gt;Messbeginn-Vorschlag: erste MIA-Begrüßung; Kanalwahl separat betrachten.&lt;br&gt;Ab etwa 90 Sekunden keine neue Erkundungsfrage. Früh überleiten.&lt;br&gt;Durchgehende Kundensprache über 120 Sekunden: Umgang noch festzulegen; kein freigegebener harter Audioabbruch.&lt;br&gt;Keine Überschreitung als „Detailphase“ verstecken." style="shape=note;size=20;whiteSpace=wrap;html=1;fillColor=#FFF2D7;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=19;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="70" y="735" width="575" height="420" as="geometry" />
        </mxCell>
        <mxCell id="unknown-note" value="&lt;b&gt;Fehlende Angaben sind zulässig&lt;/b&gt;&lt;br&gt;&lt;br&gt;Stilbilder ablehnen, „weiß nicht“ oder unbekannte Küchenform blockieren den Erstentwurf nicht.&lt;br&gt;Ein Kunde muss nicht alle Wunschfelder einzeln beantworten." style="shape=note;size=20;whiteSpace=wrap;html=1;fillColor=#FAF8F1;strokeColor=#788C80;fontColor=#193C32;fontFamily=Arial;fontSize=19;align=center;verticalAlign=middle;spacing=14;shadow=0;strokeWidth=1.5;" vertex="1" parent="1">
          <mxGeometry x="70" y="1950" width="575" height="205" as="geometry" />
        </mxCell>
